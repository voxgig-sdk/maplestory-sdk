# Entity: system

main: kit: entity: system: {

  alias: field: {}

  fields: [
    {
      format: "double"
      name: "cpuUsagePercent"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "int64"
      name: "gcGen0Collections"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "gcGen1Collections"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "gcGen2Collections"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int32"
      name: "threadCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "totalMemoryBytes"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "usedMemoryBytes"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "system"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/metrics/system"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "metrics"
            }
            {
              lit: "system"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
