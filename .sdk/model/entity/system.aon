# Entity: system

main: kit: entity: system: {

  alias: field: {}

  fields: [
    {
      name: "cpuUsagePercent"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "gcGen0Collections"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "gcGen1Collections"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "gcGen2Collections"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "threadCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "totalMemoryBytes"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "usedMemoryBytes"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "system"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/metrics/system"
          parts: [
            "api"
            "metrics"
            "system"
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
