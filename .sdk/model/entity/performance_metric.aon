# Entity: performance_metric

main: kit: entity: performance_metric: {

  alias: field: {}

  fields: [
    {
      format: "int64"
      name: "activeRequests"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "double"
      name: "averageResponseTimeMs"
      req: false
      type: "`$NUMBER`"
    }
    {
      name: "cache"
      req: false
      type: "`$OBJECT`"
    }
    {
      name: "errorsByType"
      req: false
      type: "`$OBJECT`"
    }
    {
      format: "date-time"
      name: "lastUpdated"
      req: false
      type: "`$STRING`"
    }
    {
      format: "int64"
      name: "memoryUsedBytes"
      req: false
      type: "`$INTEGER`"
    }
    {
      name: "redisCache"
      req: false
      type: "`$OBJECT`"
    }
    {
      format: "double"
      name: "requestsPerSecond"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "date-time"
      name: "startTime"
      req: false
      type: "`$STRING`"
    }
    {
      name: "system"
      req: false
      type: "`$OBJECT`"
    }
    {
      format: "int64"
      name: "totalErrors"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "totalRequests"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "wzPropertiesLoaded"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "performance_metric"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/metrics"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "metrics"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
