# Entity: metric

main: kit: entity: metric: {

  alias: field: {}

  name: "metric"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/metrics/health"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "metrics"
            }
            {
              lit: "health"
            }
          ]
          select: {
            "$action": "health"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
