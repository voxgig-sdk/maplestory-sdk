          segments: [
            {
              lit: "api"
            }
            {
              lit: "health"
            }
            {
              lit: "alive"
            }
          ]
          select: {
            "$action": "alive"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/health/ready"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "health"
            }
            {
              lit: "ready"
            }
          ]
          select: {
            "$action": "ready"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
        {
          method: "GET"
          orig: "/api/health/start"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "health"
            }
            {
              lit: "start"
            }
          ]
          select: {
            "$action": "start"
          }
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



