# Entity: cache

main: kit: entity: cache: {

  alias: field: {}

  fields: [
    {
      format: "int64"
      name: "evictionCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "hitCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "double"
      name: "hitRatio"
      req: false
      type: "`$NUMBER`"
    }
    {
      format: "int64"
      name: "memoryUsage"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "missCount"
      req: false
      type: "`$INTEGER`"
    }
    {
      format: "int64"
      name: "totalEntries"
      req: false
      type: "`$INTEGER`"
    }
  ]

  name: "cache"
  op: {
    load: {
      name: "load"
      points: [
        {
          method: "GET"
          orig: "/api/metrics/cache"
          segments: [
            {
              lit: "api"
            }
            {
              lit: "metrics"
            }
            {
              lit: "cache"
            }
          ]
          transform: {
            req: "`reqdata`"
            res: "`body`"
          }
        }
      ]
    }
  }



}
